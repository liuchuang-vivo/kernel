import("//build/boards/${board}.gni")
import("//build/templates/build_template.gni")
import("//build/templates/reload_autoconf_and_build.gni")
import("//build/templates/static_pie_app.gni")
import("//build/toolchain/blueos.gni")

reload_autoconf_and_build("shell") {
  app_conf = [ "app.conf" ]
  crate_name = "shell"
  crate_type = "bin"
  sources = [ "src/main.rs" ]
  deps = [
    "//external/rust:phf",
    "//kernel/kconfig:generate_rustflags_file",
    "//kernel/rsrt:rsrt_std",
    "//libs/libc",
    "//libs/librs",
  ]
  linker_script = default_linker_script
  configs = [
    "//build/boards/${board}:kernel_config",
    "//kernel/kconfig:kconfigs",
  ]
}

gen_qemu_runner("shell_runner") {
  img = ":shell"
  qemu = "$qemu_exe"
  machine = "$qemu_machine"
  qemu_args = qemu_extra_args
  net_args = qemu_net_args
  block_img = "shell_block.img"
  block_args = qemu_block_args
}

if (board_toolchain_info.current_cpu == "riscv32" ||
    board_toolchain_info.current_cpu == "riscv64" ||
    board_toolchain_info.current_cpu == "aarch64") {
  # The application requires VFS at runtime; it does not inherit kernel cfgs.
  static_pie_app("shell_elf") {
    crate_name = "shell"
    sources = [ "src/main.rs" ]
    features = [ "standalone" ]
    deps = [
      "//external/rust:phf",
      "//libs/libc",
    ]
  }
}

if (board == "qemu_riscv32" || board == "qemu_riscv64" ||
    board == "qemu_virt64_aarch64") {
  run_clippy("shell_elf_clippy") {
    deps = [ ":shell_elf" ]
  }

  group("run_loaded_shell_test") {
    testonly = true
    deps = [ "//kernel/loader/tests:run_loader_integration_test" ]
  }
}
