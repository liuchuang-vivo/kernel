import("//build/templates/build_template.gni")

build_rust("runtime_test_app") {
  testonly = true
  crate_type = "bin"
  sources = [ "src/main.rs" ]
  deps = [
    "//kernel/header:blueos_header",
    "//kernel/scal:blueos_scal_swi",
    "//libs/libc",
    "//libs/librs:librs_swi",
  ]
  configs += [ "//build/boards/${board}:app_config" ]
  rustflags = [
    "-Cpanic=abort",
    "-Crelocation-model=pic",
    "-Clink-arg=-Wl,-static",
    "-Clink-arg=-Wl,-pie",
    "-Clink-arg=-Wl,-no-dynamic-linker",
    "-Clink-arg=-nostartfiles",
  ]
}

run_clippy("runtime_test_app_clippy") {
  testonly = true
  deps = [ ":runtime_test_app" ]
}
